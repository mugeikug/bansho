<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Bansho</AssemblyName>
    <RootNamespace>Bansho</RootNamespace>
    <ApplicationIcon>bansho.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Product>デジタル板書</Product>
    <AssemblyTitle>デジタル板書</AssemblyTitle>
    <Company>maezhir</Company>
    <Copyright>maezhir</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- 板書の画面（ブラウザ版と同じファイル）を exe の隣の app フォルダに置く -->
  <ItemGroup>
    <Content Include="..\index.html" Link="app\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\css\*.css" Link="app\css\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\js\*.js" Link="app\js\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\icons\*.png" Link="app\icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
